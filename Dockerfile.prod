# Production Dockerfile for ITL Chatbot - Optimized for Production with Environment Variables

# ============================================================================
# Stage 1: Frontend Builder - Build React frontend
# ============================================================================
FROM node:20-alpine as frontend-builder

# Set working directory for frontend
WORKDIR /app/frontend

# Copy frontend files
COPY frontend/package*.json ./
COPY frontend/vite.config.ts ./
COPY frontend/tsconfig.json ./
COPY frontend/postcss.config.cjs ./
COPY frontend/tailwind.config.ts ./

# Install frontend dependencies
RUN npm ci --only=production

# Copy frontend source code
COPY frontend/src ./src/
COPY frontend/public ./public/
COPY frontend/index.html ./
COPY frontend/assets ./assets/

# Build frontend with production settings
RUN npm run build

# ============================================================================
# Stage 2: Backend Dependencies Builder - Install Python dependencies
# ============================================================================
FROM python:3.11-slim as backend-dependencies

# Install UV for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

# Set working directory
WORKDIR /app

# Copy dependency files (use requirements.txt for compatibility)
# Use docker-friendly requirements to avoid packages not on PyPI
COPY backend/requirements.docker.txt ./requirements.txt

# Install dependencies using pip from requirements.txt
RUN python -m pip install --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# ============================================================================
# Stage 3: Production Runtime - Minimal image with only required components
# ============================================================================
FROM python:3.11-slim

# Set production environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_NO_UPDATE_CHECK=1 \
    FASTAPI_ENV=production \
    PYTHONPATH=/app/src

# Install minimal runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    # Required for some Python packages and runtime
    libpq5 \
    # Image processing dependencies
    libjpeg62-turbo \
    libpng16-16 \
    libfreetype6 \
    # For PDF processing
    poppler-utils \
    # Security - prevent privilege escalation
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && find /usr/share/ca-certificates/mozilla -name "*.crt" -exec rm -f {} \;

# Create non-root user for security (UID 1000 as defined in your backend)
RUN groupadd -r appgroup --gid 1000 && useradd -l -r -u 1000 -g appgroup appuser

# Security: Set secure umask
ENV UMASK=027

# Set working directory
WORKDIR /app

# Copy installed Python packages from backend builder
COPY --from=backend-dependencies /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=backend-dependencies /usr/local/bin /usr/local/bin

# Copy backend application code with proper permissions
COPY --chown=appuser:appgroup backend/src ./src
COPY --chown=appuser:appgroup backend/uv.lock ./uv.lock
COPY --chown=appuser:appgroup backend/pyproject.toml ./pyproject.toml
COPY --chown=appuser:appgroup backend/init-db.sql ./init-db.sql
COPY --chown=appuser:appgroup backend/alembic.ini ./alembic.ini
COPY --chown=appuser:appgroup backend/alembic ./alembic/

# Copy .env file from backend directory with proper permissions
COPY --chown=appuser:appgroup backend/.env ./.env

# Copy built frontend from frontend builder
COPY --from=frontend-builder /app/frontend/dist ./frontend/dist

# Create uploads directory with proper permissions
RUN mkdir -p ./uploads && chown -R appuser:appgroup ./uploads

# Switch to non-root user
USER appuser

# Expose port
EXPOSE 8000

# Set up health check for production
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD python -c "import requests; requests.get('http://localhost:8000/health', timeout=5)" || exit 1

# Use gunicorn for production deployment (multiple workers)
CMD ["gunicorn", "src.main:app", "--workers", "4", "--worker-class", "uvicorn.workers.UvicornWorker", "--bind", "0.0.0.0:8000", "--timeout", "120"]