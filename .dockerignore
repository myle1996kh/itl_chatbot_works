# ============================================================================
# .dockerignore - Exclude files from Docker build context
# ============================================================================
# This file reduces build time and image size by excluding unnecessary files

# Version Control
.git
.gitignore
.github

# Python
__pycache__
*.py[cod]
*$py.class
*.so
.Python
.venv
venv/
ENV/
env/
.pytest_cache
*.egg-info
dist/
build/

# IDE
.vscode
.idea
*.swp
*.swo
*~

# Logs
*.log
logs/

# Environment files (security - never include in image)
.env
.env.*
!.env.example

# Documentation (exclude all project docs and guides)
*.md
!README.md
docs/
Documentation/
backend/Guides/
ARCHITECTURE_DIAGRAMS.md
DEPLOYMENT.md
DOCKER_*.md
CHANGELOG_FIXES.md

# Tests (exclude Bruno tests and pytest files)
tests/
backend/tests/
*.test.js
*.spec.js
*.bru

# Node modules (will be installed during build)
node_modules/

# Frontend build artifacts (will be created during build)
frontend/dist/
frontend/build/

# Database
*.db
*.sqlite
*.sqlite3

# OS
.DS_Store
Thumbs.db

# Temporary files
tmp/
temp/
*.tmp

# Coverage reports
.coverage
htmlcov/
coverage/

# Jupyter notebooks
*.ipynb
.ipynb_checkpoints

# Docker
docker-compose*.yml
Dockerfile*
.dockerignore
