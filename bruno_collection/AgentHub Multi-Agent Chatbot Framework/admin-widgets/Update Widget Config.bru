meta {
  name: Update Widget Config
  type: http
  seq: 3
}

patch {
  url: {{baseUrl}}/api/admin/tenants/:tenant_id/widget
  body: json
  auth: bearer
}

params:path {
  tenant_id: 
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "theme": "",
    "primary_color": "",
    "position": "",
    "custom_css": "",
    "auto_open": "",
    "welcome_message": "",
    "placeholder_text": "",
    "allowed_domains": "",
    "max_session_duration": "",
    "rate_limit_per_minute": "",
    "enable_file_upload": "",
    "enable_voice_input": "",
    "enable_conversation_history": ""
  }
}
