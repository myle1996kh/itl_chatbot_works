# Database Configuration
DATABASE_URL=postgresql://agenthub:secret@localhost:5432/agenthub
POSTGRES_USER=agenthub
POSTGRES_PASSWORD=secret
POSTGRES_DB=agenthub
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# JWT Authentication (RS256)
# Provide the RS256 public key for JWT verification
JWT_PUBLIC_KEY=

# Fernet Encryption Key for API Keys
# Generate with: python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
FERNET_KEY=

# Application Settings
# ENVIRONMENT: production, staging, or development
# IMPORTANT: DISABLE_AUTH cannot be true when ENVIRONMENT=production
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000

# Development Auth Toggle (ONLY for local testing)
# WARNING: Must be false in production (enforced by validation)
DISABLE_AUTH=false

# CORS Settings
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Rate Limiting
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_RATE_LIMIT_TPM=10000

# Cache Settings
CACHE_TTL_SECONDS=3600

# Database Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
