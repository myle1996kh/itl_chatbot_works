# .env Configuration Template for Production

# Copy this to your .env file and update the values

# ============================================================================
# CRITICAL SETTINGS - MUST UPDATE FOR PRODUCTION
# ============================================================================

# Authentication (CHOOSE ONE OPTION BELOW)

# --- OPTION 1: Development Mode (NO JWT) ---
# Use this for local development/testing only
DISABLE_AUTH=true
ENVIRONMENT=development
JWT_PUBLIC_KEY=

# --- OPTION 2: Production Mode (WITH JWT) ---
# Uncomment and use this for production
# DISABLE_AUTH=false
# ENVIRONMENT=production
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\nYOUR_PUBLIC_KEY_HERE\n-----END PUBLIC KEY-----"

# ============================================================================
# ENCRYPTION - ALREADY VALIDATED ✅
# ============================================================================

# Fernet Key (for encrypting tenant API keys)
# This key has been validated and is ready to use
FERNET_KEY=kN8j3xP5mR7qT9wV2yB4nL6oC1eH3fA8gD0iK5sU9jM=

# ============================================================================
# DATABASE
# ============================================================================

# PostgreSQL Connection
# IMPORTANT: Change the password to a strong one (20+ characters)
DATABASE_URL=postgresql://postgres:CHANGE_THIS_PASSWORD@localhost:5432/chatbot_itl

# Connection Pool Settings
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ============================================================================
# REDIS
# ============================================================================

REDIS_URL=redis://localhost:6379
CACHE_TTL_SECONDS=3600

# ============================================================================
# LOGGING
# ============================================================================

# Development: INFO or DEBUG
# Production: WARNING or ERROR
LOG_LEVEL=INFO

# ============================================================================
# CORS
# ============================================================================

# Development: localhost origins
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Production: your actual domains
# CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ============================================================================
# RATE LIMITING
# ============================================================================

DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_RATE_LIMIT_TPM=10000

