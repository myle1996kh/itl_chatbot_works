# ============================================================================
# ITL Chatbot - Docker Production Environment
# ============================================================================
# Copy this file to .env and update with your production values
# NEVER commit .env to version control!

# ============================================================================
# SECURITY (REQUIRED)
# ============================================================================

# Fernet Key for encrypting API keys (VALIDATED ✅)
FERNET_KEY=kN8j3xP5mR7qT9wV2yB4nL6oC1eH3fA8gD0iK5sU9jM=

# JWT Public Key (RS256) - Replace with your actual public key
# Format: "-----BEGIN PUBLIC KEY-----\nYOUR_KEY_HERE\n-----END PUBLIC KEY-----"
JWT_PUBLIC_KEY=

# Authentication (CRITICAL for production)
DISABLE_AUTH=false
ENVIRONMENT=production

# ============================================================================
# DATABASE (PostgreSQL)
# ============================================================================

DB_NAME=chatbot_itl
DB_USER=postgres
DB_PASSWORD=CHANGE_THIS_TO_STRONG_PASSWORD
DB_PORT=5432

# Connection pooling
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10

# ============================================================================
# REDIS (Caching)
# ============================================================================

REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_TTL_SECONDS=3600

# ============================================================================
# APPLICATION
# ============================================================================

# Logging
LOG_LEVEL=WARNING

# API
API_PORT=8000

# CORS - Update with your production domains
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate Limiting
DEFAULT_RATE_LIMIT_RPM=60
DEFAULT_RATE_LIMIT_TPM=10000

# ============================================================================
# LLM PROVIDERS (Optional)
# ============================================================================

OPENROUTER_API_KEY=
PROTONX_API_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJlbWFpbCI6Im15bGUxOTk2a2hAZ21haWwuY29tIiwiaWF0IjoxNzYyMjMwODM1LCJleHAiOjE3NjQ4MjI4MzV9.wrWOCUGEC_4tWFWlehvkQPzCVPB6NvscfvX_q0SzaKU

# ============================================================================
# ADMIN TOOLS (Optional - for development/debugging)
# ============================================================================

PGADMIN_EMAIL=admin@itl.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050
REDIS_COMMANDER_PORT=8081
